# Default is the real OpenAI-compatible LLM (required for normal use).
# Set LLM_PROVIDER=mock only for offline demos without a key.
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai (leave empty only if using mock)
OPENAI_API_KEY=sk-your-key-here

# Base URL must include /v1 (no trailing slash required)
# Examples:
#   https://api.openai.com/v1
#   http://HOST:7863/v1
OPENAI_BASE_URL=http://HOST:7863/v1

# Model id as accepted by your gateway
OPENAI_MODEL=glm-5.3-flash

MAX_AGENT_STEPS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Reliability (Week1 Day4) ---
# Per-request timeout for LLM HTTP calls (seconds)
LLM_TIMEOUT_S=60
# Retries after the first attempt on timeout / 429 / 5xx / transport errors
LLM_MAX_RETRIES=3
# Base for exponential backoff: LLM_RETRY_BACKOFF_S * 2^attempt (capped at 20s)
LLM_RETRY_BACKOFF_S=0.8
# Timeout wrapper around each tool invocation (seconds)
TOOL_TIMEOUT_S=15

# --- RAG (Week2) ---
# Optional: OpenAI-compatible embedding model id. If unset or /embeddings fails → local TF-IDF.
OPENAI_EMBEDDING_MODEL=
# openai (try gateway then fallback) | local (force TF-IDF)
RAG_EMBEDDING_PREFER=openai
RAG_TOP_K=3
RAG_CHUNK_CHARS=280
RAG_CHUNK_OVERLAP=60
DATABASE_URL=sqlite:///./data/ehs.db
