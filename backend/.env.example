# mock = deterministic fake LLM (default, no key needed)
# openai = any OpenAI-compatible chat API (official OpenAI, or a gateway)
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Base URL must include /v1 (no trailing slash required)
# Examples:
#   https://api.openai.com/v1
#   http://YOUR_GATEWAY_HOST/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model id as accepted by your gateway (e.g. gpt-4o-mini, glm-5.3-flash)
OPENAI_MODEL=gpt-4o-mini

MAX_AGENT_STEPS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
