# Copy to .env for docker compose (never commit .env)
# Local pytest keeps default sqlite:///./data/ehs.db unless you override DATABASE_URL.

# --- Postgres (compose `db` service) ---
POSTGRES_USER=ehs
POSTGRES_PASSWORD=ehs_change_me
POSTGRES_DB=ehs
POSTGRES_PORT=5432

# --- Ports on host ---
API_PORT=8000
WEB_PORT=5173

# --- API (injected into compose `api` service) ---
# Compose sets DATABASE_URL to postgresql+psycopg://USER:PASS@db:5432/DB automatically.
# To hit Postgres from host (uvicorn outside compose):
# DATABASE_URL=postgresql+psycopg://ehs:ehs_change_me@127.0.0.1:5432/ehs

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=http://HOST:7863/v1
OPENAI_MODEL=glm-5.3-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
AUTH_MODE=hybrid
JWT_SECRET=dev-change-me-ehs-agent-console-32b!
HITL_ENABLED=true
LOG_LEVEL=INFO
